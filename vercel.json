{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [{ "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|google.*\\.html|.*\\.txt|.*\\.xml).*)", "destination": "/index.html" }]
}
